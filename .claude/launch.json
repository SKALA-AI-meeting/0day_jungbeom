{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dayzero-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dayzero-detector-mcp",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "--python",
        "3.12",
        "python",
        "-m",
        "mcp_servers.detector.server"
      ],
      "port": 9103
    },
    {
      "name": "dayzero-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "--python",
        "3.12",
        "uvicorn",
        "app.main:app",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "dayzero-frontend-report",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_TARGET=http://127.0.0.1:8766",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}