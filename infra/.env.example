# 복사해서 infra/.env 로 쓴다. 비밀값은 커밋하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+asyncpg://dayzero:dayzero@postgres:5432/dayzero
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me-internal
API_INTERNAL_URL=http://api:8001
BUSINESS_MCP_URL=http://business-mcp:9101/mcp
RAG_MCP_URL=http://rag-mcp:9102/mcp
EMBEDDING_MODEL=BAAI/bge-m3
SCENARIOS_DIR=/scenarios
ENABLE_TEST_API=1
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=day-zero
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
