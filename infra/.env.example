# 복사해서 infra/.env 로 쓴다. 비밀값은 커밋하지 않는다.
OPENAI_API_KEY=
# 기본 gpt-4o-mini. 품질이 부족하다고 판단되면(사용자 결정) OPENAI_API_KEY를 개인 키로, OPENAI_MODEL을 GPT-6 계열 소형 모델 id로 바꾼다(모델 상향). 코드 변경 없음
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+asyncpg://dayzero:dayzero@postgres:5432/dayzero
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# JWT_SECRET: HS256 서명 키. 32바이트 이상의 임의 값으로 바꾼다(짧으면 PyJWT가 경고)
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me-internal
API_INTERNAL_URL=http://api:8001
BUSINESS_MCP_URL=http://business-mcp:9101/mcp
RAG_MCP_URL=http://rag-mcp:9102/mcp
EMBEDDING_MODEL=BAAI/bge-m3
SCENARIOS_DIR=/scenarios
ENABLE_TEST_API=1
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=day-zero
# api 공개 앱 CORS 허용 origin. 쉼표로 여러 개
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# 세션 에이전트 실행기. fake(기본)=FakeAgentRunner, session=실제 LangGraph 그래프
AGENT_RUNNER=fake
# rag-mcp 모델 캐시(compose 볼륨 hfcache가 여기에 붙음)
HF_HOME=/models

# --- 역할별 모델 (비우면 OPENAI_MODEL을 쓴다). 프롬프트 수정으로 품질이 안 나오는 역할만 올린다(사용자 결정) ---
# 키 선택 규칙: 모델 id가 gpt-4o-mini면 OPENAI_API_KEY(제한 키), 그 외 gpt-*면 OPENAI_API_KEY_PERSONAL, gemini-*면 GEMINI_API_KEY(OpenAI 호환 엔드포인트). 코드는 이 규칙만 안다
OPENAI_API_KEY_PERSONAL=
GEMINI_API_KEY=
MODEL_COLLEAGUE=
MODEL_MANAGER=
MODEL_OBSERVE=
MODEL_ASSISTANT=
MODEL_REPORT=
